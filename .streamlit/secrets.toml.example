# Copie estas chaves para a área "Secrets" do Streamlit Community Cloud.
# Nunca envie um arquivo secrets.toml preenchido para o Git.

ADZUNA_APP_ID = "sua_chave"
ADZUNA_APP_KEY = "sua_chave"
JOOBLE_API_KEY = ""

GUPY_ENABLED = "true"
JOOBLE_ENABLED = "false"

GREENHOUSE_ENABLED = "true"
GREENHOUSE_BOARD_TOKENS = "c6bank,inter,quintoandar,gympass,wildlifestudios,sumup,ebury,stone,getnet"
GREENHOUSE_CACHE_TTL_SECONDS = "300"

DATABASE_PATH = "data/search_emprego.db"
GEMINI_API_KEY = "sua_nova_chave_gemini"

# Segurança
APP_ENCRYPTION_KEY = "gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres"
APP_BASE_URL = "https://seu-dominio.example"
ADMIN_EMAILS = "admin@seu-dominio.example"
ADMIN_BOOTSTRAP_LOGIN = "escolha-um-login-administrativo"
ADMIN_BOOTSTRAP_PASSWORD = "use-uma-senha-nova-e-forte"
SESSION_TTL_HOURS = "12"
LOGIN_MAX_ATTEMPTS = "5"
LOGIN_LOCK_MINUTES = "15"
MAGIC_LINK_TTL_MINUTES = "15"
EMAIL_CODE_TTL_MINUTES = "10"
EMAIL_CODE_MAX_ATTEMPTS = "5"
EMAIL_CODE_MAX_SENDS_PER_HOUR = "5"
EMAIL_CODE_MAX_ACCOUNT_FAILURES = "10"
EMAIL_CODE_LOCK_MINUTES = "15"

# SMTP
SMTP_HOST = "smtp.seu-provedor.example"
SMTP_PORT = "587"
SMTP_USER = "usuario-smtp"
SMTP_PASSWORD = "senha-smtp"
SMTP_FROM = "SearchJob <nao-responda@seu-dominio.example>"
SMTP_USE_TLS = "true"
SMTP_USE_SSL = "false"
