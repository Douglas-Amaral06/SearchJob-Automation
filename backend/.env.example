ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# Gupy - usa endpoint público do portal
GUPY_ENABLED=true

# Greenhouse - API pública com boards verificados
# Boards consultados: empresas com presença relevante no Brasil
# Adicione tokens conforme necessário (não garante vagas brasileiras)
GREENHOUSE_ENABLED=true
GREENHOUSE_BOARD_TOKENS=c6bank,inter,quintoandar,gympass,wildlifestudios,sumup,ebury,stone,getnet
GREENHOUSE_CACHE_TTL_SECONDS=300

# Fontes públicas de vagas remotas (sem chave de API)
JOBICY_ENABLED=true
JOBICY_CACHE_TTL_SECONDS=3600
REMOTIVE_ENABLED=true
REMOTIVE_CACHE_TTL_SECONDS=21600

# Fonte com chave própria
JOOBLE_ENABLED=true

# Database
DATABASE_PATH=data/search_emprego.db

# Gemini - nunca envie a chave real para o Git
GEMINI_API_KEY=

# Segurança e autenticação
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:8501
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_LOGIN=
ADMIN_BOOTSTRAP_PASSWORD=
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAGIC_LINK_TTL_MINUTES=15
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_MAX_SENDS_PER_HOUR=5
EMAIL_CODE_MAX_ACCOUNT_FAILURES=10
EMAIL_CODE_LOCK_MINUTES=15

# E-mail SMTP para magic links
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
